# Hochgeladene Dateien: nur Bilder ausliefern, niemals Skripte ausführen
Options -Indexes -ExecCGI
<IfModule mod_mime.c>
  RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phar .pl .py .cgi
  RemoveType .php .phtml .php3 .php4 .php5 .php7 .phar
</IfModule>
<FilesMatch "(?i)\.(php\d?|phtml|phar|pl|py|cgi|sh|htaccess)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
